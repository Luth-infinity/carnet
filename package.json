{
  "name": "carnet",
  "productName": "Carnet",
  "version": "0.1.1",
  "description": "Carnet de notes de bureau : pages imbriquées, tâches et liens entre pages, enregistrés sur la machine.",
  "main": "electron/main.js",
  "author": "Luth",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3217",
    "desktop": "concurrently -k -n next,electron -c cyan,magenta \"next dev -p 3217\" \"wait-port 3217 && electron .\"",
    "build": "next build",
    "start": "npm run build && electron . --static",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist": "npm run build && electron-builder --mac --win"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Luth-infinity/carnet.git"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@tailwindcss/postcss": "^4",
    "@tiptap/extension-code-block-lowlight": "^3.31.3",
    "@tiptap/extension-collaboration": "^3.31.3",
    "@tiptap/extension-details": "^3.31.3",
    "@tiptap/extension-drag-handle": "^3.31.3",
    "@tiptap/extension-drag-handle-react": "^3.31.3",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/extension-list": "^3.31.3",
    "@tiptap/extension-mention": "^3.31.3",
    "@tiptap/extension-node-range": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-typography": "^3.31.3",
    "@tiptap/extensions": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/suggestion": "^3.31.3",
    "@tiptap/y-tiptap": "^3.0.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.6",
    "concurrently": "^10.0.5",
    "electron": "^41.10.7",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "frimousse": "^0.3.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.45.0",
    "motion": "^13.2.0",
    "nanoid": "^6.0.1",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "wait-port": "^1.1.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32",
    "zustand": "^5.0.15"
  }
}
